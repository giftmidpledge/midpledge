;;
;; Routing of a Contract GiftLoanPool
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'owner, $self'treasury, $self'signerKey, $self'maxLoan) = $GiftLoanPool$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive DeployEscrow message
    if (op == 0xb0123410) {
        var $msg'nft = in_msg~load_msg_addr();
        throw_unless(62132, ($Context$_get_value(__tact_context_get()) >= 150000000));
        $global_deploy($DeployParameters$_constructor_init_value_mode_bounce($LoanEscrow$_init_child($global_myAddress(), $msg'nft), 80000000, 1, false));
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    
    ;; Receive LoanRequest message
    if (op == 0xb0123411) {
        var $msg'nft = in_msg~load_msg_addr();
        var $msg'borrower = in_msg~load_msg_addr();
        var $msg'principal = in_msg~load_varuint16();
        var $msg'term = in_msg~load_uint(16);
        var $msg'exp = in_msg~load_uint(32);
        var $msg'sig = in_msg~load_ref();
        slice $escrow = $global_contractAddress($LoanEscrow$_init_child($global_myAddress(), $msg'nft));
        throw_unless(11244, ( equal_slices_bits(__tact_context_get_sender(), $escrow) ));
        int $ok = false;
        int $repay = 0;
        try {
            int $rate = ($self'owner, $self'treasury, $self'signerKey, $self'maxLoan)~$GiftLoanPool$_fun_rateBps($msg'term);
            int $h = $Cell$_fun_hash($Builder$_fun_endCell(store_uint(store_uint($Builder$_fun_storeCoins($Builder$_fun_storeAddress($Builder$_fun_storeAddress($Builder$_fun_storeAddress($global_beginCell(), $global_myAddress()), $msg'nft), $msg'borrower), $msg'principal), $msg'term, 16), $msg'exp, 32)));
            if (( (( (( (( (( (($rate > 0)) ? (($msg'principal > 0)) : (false) )) ? (($msg'principal <= $self'maxLoan)) : (false) )) ? (($global_now() <= $msg'exp)) : (false) )) ? ((($global_myBalance() - $Context$_get_value(__tact_context_get())) >= ($msg'principal + 500000000))) : (false) )) ? ($global_checkSignature($h, $Cell$_fun_beginParse($msg'sig), $self'signerKey)) : (false) )) {
                int $interest = ((($msg'principal * $rate) + 9999) / 10000);
                $repay = ($msg'principal + $interest);
                $ok = true;
            }
        } catch (_, $e) {
            $ok = false;
        }
        if ($ok) {
            $global_send($SendParameters$_constructor_to_value_mode_bounce_body($escrow, 50000000, 1, false, $LoanApproved$_store_cell($LoanApproved$_constructor_repay_principal_dueAt_owner_treasury($repay, $msg'principal, ($global_now() + ($msg'term * 86400)), $self'owner, $self'treasury), begin_cell())));
            $global_send($SendParameters$_constructor_to_value_mode_bounce($msg'borrower, $msg'principal, 1, false));
        } else {
            $global_send($SendParameters$_constructor_to_value_mode_bounce_body($escrow, 0, 66, false, $LoanRejected$_store_cell($LoanRejected$_constructor_(), begin_cell())));
        }
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    
    ;; Receive Withdraw message
    if (op == 0xb0123404) {
        var $msg'amount = in_msg~load_varuint16();
        throw_unless(57920, ( equal_slices_bits(__tact_context_get_sender(), $self'owner) ));
        throw_unless(44940, (($global_myBalance() - $msg'amount) >= 500000000));
        $global_send($SendParameters$_constructor_to_value_mode($self'owner, $msg'amount, 1));
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    
    ;; Receive SetMaxLoan message
    if (op == 0xb0123405) {
        var $msg'value = in_msg~load_varuint16();
        throw_unless(57920, ( equal_slices_bits(__tact_context_get_sender(), $self'owner) ));
        $self'maxLoan = $msg'value;
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    
    ;; Receive RescueNft message
    if (op == 0xb0123414) {
        var $msg'nft = in_msg~load_msg_addr();
        var $msg'to = in_msg~load_msg_addr();
        throw_unless(57920, ( equal_slices_bits(__tact_context_get_sender(), $self'owner) ));
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($global_contractAddress($LoanEscrow$_init_child($global_myAddress(), $msg'nft)), 150000000, 1, true, $Rescue$_store_cell($Rescue$_constructor_to($msg'to), begin_cell())));
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    
    ;; Receive RescueAnyNft message
    if (op == 0xb0123416) {
        var $msg'nft = in_msg~load_msg_addr();
        var $msg'to = in_msg~load_msg_addr();
        throw_unless(57920, ( equal_slices_bits(__tact_context_get_sender(), $self'owner) ));
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($msg'nft, 150000000, 1, true, $NftTransfer$_store_cell($NftTransfer$_constructor_queryId_newOwner_responseDestination_customPayload_forwardAmount_forwardPayload(0, $msg'to, $msg'to, null(), 0, $global_emptySlice()), begin_cell())));
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    
    ;; Receive RescueForeignNft message
    if (op == 0xb0123417) {
        var $msg'escrowNft = in_msg~load_msg_addr();
        var $msg'foreign = in_msg~load_msg_addr();
        var $msg'to = in_msg~load_msg_addr();
        throw_unless(57920, ( equal_slices_bits(__tact_context_get_sender(), $self'owner) ));
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($global_contractAddress($LoanEscrow$_init_child($global_myAddress(), $msg'escrowNft)), 150000000, 1, true, $RescueForeign$_store_cell($RescueForeign$_constructor_nft_to($msg'foreign, $msg'to), begin_cell())));
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $GiftLoanPool$_contract_store(($self'owner, $self'treasury, $self'signerKey, $self'maxLoan));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}


() __tact_selector_hack_asm() impure asm """
@atend @ 1 {
        execute current@ context@ current!
        {
            // The core idea of this function is to save gas by avoiding unnecessary dict jump, when recv_internal/recv_external is called
            // We want to extract recv_internal/recv_external from the dict and select needed function
            // not by jumping to the needed function by it's index, but by using usual IF statements.

            }END> b> // Close previous builder, now we have a cell of previous code on top of the stack

            <{ // Start of the new code builder
                SETCP0
                // Swap the new code builder with the previous code, now we have previous code on top of the stack
                swap
                // Transform cell to slice and load first ref from the previous code, now we have the dict on top of the stack
                <s ref@

                // Extract the recv_internal from the dict
                dup 0 swap @procdictkeylen idict@ { "internal shortcut error" abort } ifnot
                swap

                // Delete the recv_internal from the dict
                0 swap @procdictkeylen idict- drop
                // Delete the recv_external from the dict (it's okay if it's not there)
                -1 swap @procdictkeylen idict- drop
                // Delete the __tact_selector_hack from the dict
                65535 swap @procdictkeylen idict- drop

                // Bring the code builder from the bottom of the stack
                // because if recv_external extraction is optional, and the number of elements on the stack is not fixed
                depth 1- roll
                // Swap with the dict from which we extracted recv_internal and (maybe) recv_external
                swap

                // Check if the dict is empty
                dup null?
                // Store a copy of this flag in the bottom of the stack
                dup depth 1- -roll
                {
                    // If the dict is empty, just drop it (it will be null if it's empty)
                    drop
                }
                {
                    // If the dict is not empty, prepare continuation to be stored in c3
                    <{
                        // Save this dict as first ref in this continuation, it will be pushed in runtime by DICTPUSHCONST
                        swap @procdictkeylen DICTPUSHCONST
                        // Jump to the needed function by it's index
                        DICTIGETJMPZ
                        // If such key is not found, throw 11 along with the key as an argument
                        11 THROWARG
                    }> PUSHCONT
                    // Store the continuation in c3
                    c3 POP
                } cond

                // Function id is on top of the (runtime) stack
                DUP IFNOTJMP:<{
                    // place recv_internal here
                    DROP swap @addop
                }>

                // Bring back the flag, indicating if the dict is empty or not from the bottom of the stack
                depth 1- roll
                {
                    // If the dict is empty, throw 11
                    11 THROWARG
                }
                {
                    // If the dict is not empty, jump to continuation from c3
                    c3 PUSH JMPX
                } cond
            }> b>
        } : }END>c
        current@ context! current!
    } does @atend !
""";

() __tact_selector_hack() method_id(65535) {
    return __tact_selector_hack_asm();
}